<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.InventoryController"
            stylesheets="@../css/style.css"
            prefWidth="1280" prefHeight="820">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>

            <Label text="Java Café" styleClass="app-title"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Pedidos"    styleClass="nav-btn" onAction="#goToOrders"/>
            <Button text="Estoque"    styleClass="nav-btn, nav-active" onAction="#goToInventory"/>
            <Button text="Relatórios" styleClass="nav-btn" onAction="#goToReports"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="0">

            <VBox styleClass="panel-left" prefWidth="760" spacing="16">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Estoque de Produtos" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>

                    <TextField fx:id="inventorySearchField"
                               promptText="Buscar produto..."
                               styleClass="search-field"
                               prefWidth="200"
                               onKeyReleased="#onSearch"/>

                    <ComboBox fx:id="categoryFilterCombo"
                              promptText="Categoria"
                              styleClass="payment-combo"
                              prefWidth="130"
                              onAction="#onCategoryFilter">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="Todos"/>
                                <String fx:value="Bebidas"/>
                                <String fx:value="Comidas"/>
                                <String fx:value="Sobremesas"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox fx:id="alertBanner" styleClass="alert-banner"
                      alignment="CENTER_LEFT" spacing="10"
                      managed="false" visible="false">
                    <padding><Insets top="8" right="14" bottom="8" left="14"/></padding>
                    <Label text="!" styleClass="alert-icon"/>
                    <Label fx:id="alertBannerText"
                           text="Atenção: alguns itens estão com estoque baixo!"
                           styleClass="alert-text"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Ver" styleClass="btn-ghost-small" onAction="#scrollToLowStock"/>
                </HBox>

                <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS" styleClass="inventory-table">
                    <columns>
                        <TableColumn fx:id="colProductId"       text="ID"         prefWidth="55"   style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colProductName"     text="Produto"    prefWidth="195"  style="-fx-alignment: CENTER_LEFT;"/>
                        <TableColumn fx:id="colProductCategory" text="Categoria"  prefWidth="100"  style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colProductPrice"    text="Preço (R$)" prefWidth="100"  style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colProductStock"    text="Estoque"    prefWidth="85"   style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colProductThreshold" text="Limite"   prefWidth="65"   style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colProductStatus"   text="Status"     prefWidth="80"   style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="Nenhum produto encontrado." styleClass="placeholder-label"/>
                    </placeholder>
                </TableView>

                <HBox spacing="24" alignment="CENTER_LEFT" styleClass="table-footer">
                    <padding><Insets top="8" right="12" bottom="8" left="12"/></padding>
                    <Label fx:id="totalProductsLabel"  text="Total: 0 produtos"     styleClass="footer-stat"/>
                    <Label fx:id="lowStockCountLabel"  text="Estoque baixo: 0"   styleClass="footer-stat-warn"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Exportar CSV" styleClass="btn-ghost" onAction="#exportCSV"/>
                </HBox>
            </VBox>

            <VBox styleClass="panel-right" prefWidth="520" spacing="0">

                <HBox styleClass="form-header" alignment="CENTER_LEFT" spacing="0">
                    <ToggleButton fx:id="tabAddProduct"
                                  text="Novo Produto"
                                  styleClass="form-tab, form-tab-active"
                                  selected="true"
                                  onAction="#switchToAdd"/>
                    <ToggleButton fx:id="tabEditProduct"
                                  text="Editar / Repor"
                                  styleClass="form-tab"
                                  onAction="#switchToEdit"/>
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">

                    <VBox fx:id="addProductPane" spacing="14" visible="true" managed="true">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                        <Label text="Dados do Produto" styleClass="form-section-title"/>

                        <VBox spacing="4">
                            <Label text="Nome do Produto *" styleClass="field-label"/>
                            <TextField fx:id="newNameField" promptText="Ex: Cappuccino" styleClass="form-field"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Categoria *" styleClass="field-label"/>
                            <ComboBox fx:id="newCategoryCombo"
                                      promptText="Selecionar categoria"
                                      styleClass="form-field"
                                      maxWidth="Infinity">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Bebidas"/>
                                        <String fx:value="Comidas"/>
                                        <String fx:value="Sobremesas"/>
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Preço (R$) *" styleClass="field-label"/>
                                <TextField fx:id="newPriceField" promptText="0,00" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Estoque Inicial *" styleClass="field-label"/>
                                <TextField fx:id="newStockField" promptText="0" styleClass="form-field"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Limite de Estoque Baixo" styleClass="field-label"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Spinner fx:id="newThresholdSpinner"
                                         prefWidth="100"
                                         editable="true"
                                         styleClass="qty-spinner"/>
                                <Label text="unidades" styleClass="field-hint"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Descrição (opcional)" styleClass="field-label"/>
                            <TextArea fx:id="newDescField"
                                      promptText="Breve descrição do item..."
                                      styleClass="form-textarea"
                                      prefRowCount="3"
                                      wrapText="true"/>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <HBox spacing="10">
                            <Button text="Limpar" styleClass="btn-secondary" prefWidth="120"
                                    onAction="#clearAddForm"/>
                            <Button text="Adicionar Produto" styleClass="btn-primary"
                                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    onAction="#addProduct"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="editProductPane" spacing="14" visible="false" managed="false">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                        <Label text="Selecione um produto na tabela" styleClass="form-section-title"/>

                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Produto selecionado:" styleClass="field-label"/>
                            <Label fx:id="selectedProductLabel" text="—" styleClass="selected-badge"/>
                        </HBox>

                        <Separator/>

                        <Label text="Atualizar Informações" styleClass="form-section-title"/>

                        <VBox spacing="8">
                            <Label text="Imagem do Produto" styleClass="field-label"/>
                            <ImageView fx:id="editImagePreview"
                                       fitWidth="220"
                                       fitHeight="140"
                                       pickOnBounds="true"
                                       preserveRatio="true"/>
                            <HBox spacing="8">
                                <TextField fx:id="editImageField"
                                           promptText="Ex: images/products/cookie.jpg"
                                           styleClass="form-field"
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="Escolher..."
                                        styleClass="btn-ghost-small"
                                        onAction="#browseEditImage"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Nome" styleClass="field-label"/>
                            <TextField fx:id="editNameField" styleClass="form-field"/>
                        </VBox>

                        <HBox spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Preço (R$)" styleClass="field-label"/>
                                <TextField fx:id="editPriceField" styleClass="form-field"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Limite de Alerta" styleClass="field-label"/>
                                <Spinner fx:id="editThresholdSpinner"
                                         prefWidth="100"
                                         editable="true"
                                         styleClass="qty-spinner"/>
                            </VBox>
                        </HBox>

                        <Button text="Salvar Alterações" styleClass="btn-secondary"
                                maxWidth="Infinity" onAction="#saveEdits"/>

                        <Separator/>

                        <Label text="Repor Estoque" styleClass="form-section-title"/>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Adicionar:" styleClass="field-label"/>
                            <Spinner fx:id="restockSpinner"
                                     prefWidth="100"
                                     min="1" max="9999" initialValue="10"
                                     editable="true"
                                     styleClass="qty-spinner"/>
                            <Label text="unidades" styleClass="field-hint"/>
                        </HBox>

                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label text="Estoque atual:" styleClass="field-label"/>
                            <Label fx:id="currentStockLabel" text="—" styleClass="stock-value"/>
                        </HBox>

                        <Button text="Repor Estoque" styleClass="btn-primary"
                                maxWidth="Infinity" onAction="#restockProduct"/>

                        <Separator/>

                        <Button text="Remover Produto" styleClass="btn-danger"
                                maxWidth="Infinity" onAction="#removeProduct"/>

                    </VBox>
                </StackPane>

                <HBox styleClass="form-status-bar" alignment="CENTER_LEFT">
                    <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
                    <Label fx:id="formStatusLabel" text="" styleClass="form-status-text"/>
                </HBox>

            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
            <Label fx:id="statusLabel" text="Pronto" styleClass="status-text"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="clockLabel" text="00:00" styleClass="status-clock"/>
        </HBox>
    </bottom>

</BorderPane>